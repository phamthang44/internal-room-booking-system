# Copy to .env.prod. Used for both Compose interpolation and backend environment.
# URLs must have NO trailing slash. Use the same hostname in Cloudflare and Google.
PUBLIC_APP_URL=https://roomhub.online
PUBLIC_WS_URL=wss://roomhub.online/ws
CLOUDFLARE_TUNNEL_TOKEN=

POSTGRES_USER=room_booking
POSTGRES_PASSWORD=
POSTGRES_DB=room_booking_db
RABBITMQ_USER=room_booking
RABBITMQ_PASSWORD=

# Existing RSA keys go in ./certs/private.pem and ./certs/public.pem.
REGISTRATION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=room-booking-uploads
MJ_APIKEY_PUBLIC=
MJ_APIKEY_PRIVATE=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_ADMIN_EMAIL=
APP_SOCIAL_INSTAGRAM_URL=
APP_SOCIAL_FACEBOOK_URL=
APP_SOCIAL_PINTEREST_URL=
APP_SOCIAL_TWITTER_URL=
APP_SEEDER_USER_ENABLED=false
APP_TIMEZONE=Asia/Ho_Chi_Minh
