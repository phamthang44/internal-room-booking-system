# .env.prod.example — Template for production secrets
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.prod and fill in REAL values on the server.
# NEVER commit .env.prod — it is gitignored.
#
#   cp .env.prod.example .env.prod
#   nano .env.prod    # fill in the blanks
# ─────────────────────────────────────────────────────────────────────────────

# ── Database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=room_booking_db

# ── RabbitMQ
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_USERNAME=

# ── JWT RSA Keys (mounted via ./certs volume)
JWT_PRIVATE_KEY_PATH=file:/app/certs/private.pem
JWT_PUBLIC_KEY_PATH=file:/app/certs/public.pem
REGISTRATION_KEY=

# ── App URLs
FRONTEND_APP_BASE_URL=https://yourdomain.com
BACKEND_APP_BASE_URL=https://api.yourdomain.com

# ── Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=room-booking-uploads

# ── Mailjet (production email provider)
MJ_APIKEY_PUBLIC=
MJ_APIKEY_PRIVATE=

# ── Gmail SMTP (fallback / alternative)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_ADMIN_EMAIL=

# ── Optional social links for email templates
APP_SOCIAL_INSTAGRAM_URL=
APP_SOCIAL_FACEBOOK_URL=
APP_SOCIAL_PINTEREST_URL=
APP_SOCIAL_TWITTER_URL=

# ── Feature flags
APP_SEEDER_USER_ENABLED=false
